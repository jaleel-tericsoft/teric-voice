# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# OpenAI — used for speech-to-text (Whisper) AND for interpreting spoken
# answers into structured field values (gpt-4o-mini)
OPENAI_API_KEY=

# ElevenLabs — used for text-to-speech (reading questions aloud)
ELEVENLABS_API_KEY=
# Optional: pick a specific voice (elevenlabs.io Voice Library → Copy Voice ID).
# Defaults to ElevenLabs' built-in "Rachel" voice if left blank.
ELEVENLABS_VOICE_ID=

# Basic app-wide login gate (see proxy.ts) — one shared email/password
# required to reach anything past /login. Not per-user auth; just keeps
# random visitors off the deployed app and away from your API usage.
AUTH_EMAIL=
AUTH_PASSWORD=

# ElevenLabs Agents (Conversational AI) — the agent that runs the whole
# voice conversation (listening + speaking + structured answers via tools).
# Create it once via the ElevenLabs API/dashboard with auth required
# (platform_settings.auth.enable_auth: true), then put its ID here.
ELEVENLABS_AGENT_ID=
